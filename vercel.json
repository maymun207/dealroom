{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/config", "destination": "/api/config.js" },
    { "source": "/api/db", "destination": "/api/db.js" },
    { "source": "/api/upload", "destination": "/api/upload.js" }
  ]
}
